            ],
            "text/html": [
              "\n",
              "     <input type=\"file\" id=\"files-51958004-27e4-4617-a9df-21082b9352ee\" name=\"files[]\" multiple disabled\n",
              "        style=\"border:none\" />\n",
              "     <output id=\"result-51958004-27e4-4617-a9df-21082b9352ee\">\n",
              "      Upload widget is only available when the cell has been executed in the\n",
              "      current browser session. Please rerun this cell to enable.\n",
              "      </output>\n",
              "      <script>// Copyright 2017 Google LLC\n",
              "//\n",
