    {
      "cell_type": "code",
      "source": [
        "# # Este script funciona porque se corrio antes ** LA REGLA DE LA FUGA\n",
        "## DEFINIR X (PREGUNTAS) e Y (RESPUESTAS) ---\n",
        "# Quitamos las columnas de texto originales y el ID para que el modelo no se confunda\n",
        "X = dataframe.drop(columns=['ID', 'GENERO', 'E_CIVIL', 'FUGA', 'FUGA_NUM'])\n",
        "y = dataframe['FUGA_NUM']"
