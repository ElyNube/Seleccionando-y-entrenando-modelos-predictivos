    {
      "cell_type": "code",
      "source": [
        "# 1. Definimos la regla de traducción en un diccionario\n",
        "# Masculino = 0, Femenino = 1\n",
        "regla_genero = {'M': 0, 'F': 1}\n",
        "\n",
        "# 2. Aplicamos el cambio a la columna\n",
        "# Es recomendable crear una columna nueva (ej. GENERO_NUM) para no borrar la original\n",
        "dataframe['GENERO_NUM'] = dataframe['GENERO'].map(regla_genero)\n",
        "\n",
        "# 3. Verificamos que el cambio se hizo correctamente\n",
        "print(\"Conteo de valores en la nueva columna:\")\n",
        "print(dataframe['GENERO_NUM'].value_counts())\n",
