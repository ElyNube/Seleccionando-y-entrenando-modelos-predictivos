    {
      "cell_type": "markdown",
      "source": [
        "## SESGO DE MEDICION VARIABLES:   M_MOROSO - MONTO - EDAD\n",
        "# Tambien existe la variable  seguro que para este caso no consideraremos."
      ],
      "metadata": {
        "id": "qaYcYCLsGF6I"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# SESGO DE MEDICION - M_MOROSO- Agregamos Ruido a los Datos\n",
        "# 1. Creamos la copia para el experimento de sesgo de medición\n",
        "data_measurement_bias = dataframe.copy()\n",
        "\n",
        "# 2. Definimos la cantidad de registros (n)\n",
        "n = len(data_measurement_bias)\n",
        "\n",
        "# 3. Agregamos ruido aleatorio a tu variable M_MOROSO, ruido proporcional a la escala pequeña (0 a 3)\n",
        "# np.random.normal(media, desviacion_estandar, n) -Usamos una desviación estándar de 0.7 para que el error sea de máximo 1 o 2 unidades\n",
        "ruido_proporcional = np.random.normal(0, 0.7, n)\n",
        "\n",
        "# 4.Aplicamos el ruido y redondeamos (round) para que queden números enteros\n",
        "# Luego aseguramos que no haya valores negativos con el método .clip(lower=0)\n",
        "data_measurement_bias[\"M_MOROSO\"] = (data_measurement_bias[\"M_MOROSO\"] + ruido_proporcional).round().clip(lower=0)\n",
        "\n",
        "\n",
        "# 5.Verificamos la diferencia real\n",
        "print(\"--- COMPARACIÓN DE M_MOROSO (Escala Realista para Sesgo de Medición) ---\")\n",
        "comparacion = pd.DataFrame({\n",
        "    'M_MOROSO_REAL': dataframe['M_MOROSO'].head(10),\n",
        "    'M_MOROSO_CON_RUIDO': data_measurement_bias['M_MOROSO'].head(10)\n",
        "})\n",
        "print(comparacion)\n",
        "\n",
        "# 6. Vista previa del nuevo dataset para confirmar\n",
        "data_measurement_bias.head()\n",
        "\n"
      ],
