    {
      "cell_type": "code",
      "source": [
        "# # SESGO DE MEDICION - EDAD- Agregamos Ruido a los Datos\n",
        "# 1. Creamos la copia\n",
        "data_measurement_bias = dataframe.copy()\n",
        "\n",
        "# LIMPIEZA DE SEGURIDAD: Quitamos espacios y pasamos todo a MAYÚSCULAS\n",
        "data_measurement_bias.columns = data_measurement_bias.columns.str.strip().str.upper()\n",
        "\n",
        "# 2. Definimos la cantidad de registros (n)\n",
        "n = len(data_measurement_bias)\n",
        "\n",
        "# 3. Agregamos ruido aleatorio a EDAD - Usamos 5 (años) como desviación estándar\n",
        "# (Ahora estamos seguros de que se llama EDAD por el paso de limpieza anterior)\n",
        "# Esto simula que el dato puede fallar por unos pocos años.\n",
        "ruido_edad = np.random.normal(0, 5, n)\n",
        "\n",
        "\n",
        "# Aplicamos ruido, redondeamos a entero y aseguramos un mínimo de 18 años\n",
        "data_measurement_bias[\"EDAD\"] = (data_measurement_bias[\"EDAD\"] + ruido_edad).round().clip(lower=18)\n",
        "\n",
        "\n",
        "# 4. Verificamos la diferencia\n",
        "print(\"--- COMPARACIÓN DE EDAD (Original vs Sesgo de Medición) ---\")\n",
        "# Aplicamos la misma limpieza al dataframe original para la comparación\n",
        "dataframe.columns = dataframe.columns.str.strip().str.upper()\n",
        "\n",
        "comparacion = pd.DataFrame({\n",
        "    'EDAD_REAL': dataframe['EDAD'].head(),\n",
        "    'EDAD_CON_RUIDO': data_measurement_bias['EDAD'].head()\n",
        "})\n",
        "print(comparacion)\n",
        "\n",
        "# 5. Vista previa\n",
        "data_measurement_bias.head()\n",
        "\n",
        "\n"
      ],
