      "cell_type": "markdown",
      "source": [
        "# Matriz de Confusion y Reporte de Clasificacion"
      ],
      "metadata": {
        "id": "4c3lO4q6u6rG"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# --- FASE 5: REPORTE DE CLASIFICACIÓN FINAL ---\n",
        "from sklearn.metrics import confusion_matrix, classification_report\n",
        "import seaborn as sns\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# 1. Convertir predicciones continuas en categorías (0 o 1)\n",
        "# Usamos el umbral estándar de 0.5\n",
        "umbral = 0.5\n",
        "y_pred_final = [1 if p >= umbral else 0 for p in predictions]\n",
        "\n",
        "# 2. Generar la Matriz de Confusión\n",
        "cm = confusion_matrix(y_train, y_pred_final)\n",
        "\n",
        "# 3. Visualización elegante de la Matriz\n",
        "plt.figure(figsize=(8, 6))\n",
        "sns.heatmap(cm, annot=True, fmt='d', cmap='Blues',\n",
        "            xticklabels=['Predicho: NO', 'Predicho: SI'],\n",
        "            yticklabels=['Real: NO', 'Real: SI'])\n",
        "\n",
        "plt.title('Matriz de Confusión Final (Datos Limpios)')\n",
        "plt.xlabel('Predicción del Modelo')\n",
        "plt.ylabel('Realidad (Datos Históricos)')\n",
        "plt.show()\n",
        "\n",
        "# 4. El Reporte Matemático\n",
        "print(\"\\n\" + \"=\"*30)\n",
        "print(\" REPORTE DE MÉTRICAS FINALES \")\n",
        "print(\"=\"*30)\n",
        "print(classification_report(y_train, y_pred_final))"
      ],
