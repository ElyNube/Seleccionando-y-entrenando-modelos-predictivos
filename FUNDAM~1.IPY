    {
      "cell_type": "code",
      "source": [
        "# Penalizamos artificialmente a GENERO\n",
        "#data_historical_bias = dataframe.copy()\n",
        "#data_historical_bias.loc[data_historical_bias[\"GENERO\"] == 'M', \"FUGA\"] = 'FUGA'\n",
        "#data_historical_bias.head()"
      ],
      "metadata": {
        "id": "8wFV0jZBVLdz"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Penalizamos artificialmente a un CIUDAD\n",
        "data_historical_bias=dataframe.copy()\n",
        "\n",
        "data_historical_bias.loc[data_historical_bias[\"CIUDAD\"] == 'SANTIAGO', \"FUGA\"] = \"FUGA\"\n",
        "# 1. Definimos la regla de traducción en un diccionario\n",
        "# NOFUGA = 0, FUGA = 1\n",
        "regla_fuga= {'NOFUGA': 0, 'FUGA': 1}\n",
        "\n",
        "# 2. Aplicamos el cambio a la columna\n",
        "# Es recomendable crear una columna nueva (ej. FUGA_NUM) para no borrar la original\n",
        "data_historical_bias['FUGA_NUM'] = data_historical_bias['FUGA'].map(regla_fuga)\n",
        "\n",
        "# 3. Verificamos que el cambio se hizo correctamente\n",
        "print(\"Conteo de valores en la nueva columna:\")\n",
        "print(data_historical_bias['FUGA_NUM'].value_counts())\n",
        "\n",
        "# Mostramos las primeras filas para comparar\n",
        "print(\"\\nComparación de columnas:\")\n",
        "print(data_historical_bias[['CIUDAD','FUGA', 'FUGA_NUM']].head())"
      ],
