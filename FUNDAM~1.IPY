    {
      "cell_type": "markdown",
      "source": [
        "# Fase 3: Preparacion de los Datos (limpieza y preprocesamiento)"
      ],
      "metadata": {
        "id": "bgMQTIAr108Q"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "## Seleccionamos las columnas que vamos a rellenar con valor CERO porque estan con valor nulo\n",
        "columnas = ['D_Marzo', 'D_Abril', 'D_Julio', 'D_Agosto', 'M_MOROSO', 'MONTO']\n",
        "\n",
        "# Rellenamos con 0 para que ya no existan los NaN que bloquean el código\n",
        "dataframe[columnas] = dataframe[columnas].fillna(0)\n",
        "\n",
        "# Ahora que no hay NaN, ya puedes usar int64 (minúscula)\n",
        "dataframe[columnas] = np.round(dataframe[columnas]).astype('int64')"
      ],
      "metadata": {
        "id": "44ToayQN6P-w"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "### REEMPLAZANDO ESOS VALOR, EDAD < 0,  POR LA MEDIANA\n",
        "## 1Calculamos la mediana primero (de los valores que sí son correctos)\n",
        "mediana_edad = dataframe[dataframe['EDAD'] >= 0]['EDAD'].median()\n",
        "\n",
        "## 2Reemplazamos solo donde la edad sea menor a 0\n",
        "dataframe.loc[dataframe['EDAD'] < 0, 'EDAD'] = mediana_edad"
      ],
      "metadata": {
        "id": "YS-m4Kfp6Pwt"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "## Reemplazar los valores nulos de la Columna EDAD por la mediana porque es mucho\n",
        "## mas robusta y representa mejor al sujetopromedio del grupo\n",
        "dataframe['EDAD'] = dataframe['EDAD'].fillna(dataframe['EDAD'].median())\n",
        "\n",
        "## Reemplazar los valores nulos de la Columna GENERO por la moda\n",
        "dataframe['GENERO'] = dataframe['GENERO'].fillna(dataframe['GENERO'].mode()[0])\n",
        "\n",
        "## Reemplazar los valores nulos de la Columna NIV_EDUC por la moda\n",
        "dataframe['NIV_EDUC'] = dataframe['NIV_EDUC'].fillna(dataframe['NIV_EDUC'].mode()[0])\n",
        "\n",
        "## Reemplazar los valores nulos de la Columna E_CIVIL por la moda\n",
        "dataframe['E_CIVIL'] = dataframe['E_CIVIL'].fillna(dataframe['E_CIVIL'].mode()[0])\n",
        "\n",
        "## Reemplazar los valores nulos de la Columna CIUDAD por la moda\n",
        "dataframe['CIUDAD'] = dataframe['CIUDAD'].fillna(dataframe['CIUDAD'].mode()[0])"
      ],
      "metadata": {
        "id": "x8nxOGn77nwk"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# ESCALADO para mantener una misma escala numerica valores a entero : EDAD.\n",
        "import numpy as np #\n",
        "dataframe['EDAD'] = np.round(dataframe['EDAD']).astype('int64')"
      ],
      "metadata": {
        "id": "l0RUM5nl5lL3"
