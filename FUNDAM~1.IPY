\": 0.0,\n        \"max\": 88837.0,\n        \"num_unique_values\": 705,\n        \"samples\": [\n          14482.0,\n          824.0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"D_Septiembre\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 9868,\n        \"min\": 0,\n        \"max\": 249652,\n        \"num_unique_values\": 881,\n        \"samples\": [\n          71,\n          95\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"M_MOROSO\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 0.7521972944902355,\n        \"min\": 0.0,\n        \"max\": 3.0,\n        \"num_unique_values\": 4,\n        \"samples\": [\n          1.0,\n          3.0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"MONTO\",\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 2293165.5267322017,\n        \"min\": 500000.0,\n        \"max\": 8000000.0,\n        \"num_unique_values\": 78,\n        \"samples\": [\n          5700000.0,\n          2000000.0\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"SEGURO\",\n      \"properties\": {\n        \"dtype\": \"category\",\n        \"num_unique_values\": 2,\n        \"samples\": [\n          \"SI\",\n          \"NO\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    },\n    {\n      \"column\": \"FUGA\",\n      \"properties\": {\n        \"dtype\": \"category\",\n        \"num_unique_values\": 2,\n        \"samples\": [\n          \"FUGA\",\n          \"NOFUGA\"\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
