    {
      "cell_type": "markdown",
      "source": [
        "** NOTA : Correr antes Fase 3"
      ],
      "metadata": {
        "id": "YjivqG30PGcE"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# REGLA DE LA FUGA\n",
        "## Para que todas las Graficas y Script se desplieguen debo correr este script\n",
        "\n",
        "##1. Nos aseguramos de que FUGA_NUM exista en el dataframe original--- Porque cree SESGOS, y al trabajar con SESGOS, cree copias nuevas\n",
        "## como data_historical_bias o  data_measurement_bias pero no guarde esa columna en el dataframe original o quizás reinicie el entorno\n",
        "# y no volvi a correr la celda donde cree FUGA_NUM\n",
        "\n",
        "regla_fuga = {'NOFUGA': 0, 'FUGA': 1}\n",
        "dataframe['FUGA_NUM'] = dataframe['FUGA'].map(regla_fuga)"
      ],
      "metadata": {
        "id": "vthWwN_8R4-U"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "## Analisis variable Fuga\n",
        "plt.figure(figsize=(8, 4))\n",
        "sns.histplot(dataframe['FUGA_NUM'], kde=True, color='red')\n",
        "plt.title(\"Distribución de FUGA - Escala Original\")\n",
        "plt.xlabel(\"FUGA\")\n",
        "plt.ylabel(\"Frecuencia\")\n",
        "plt.grid(alpha=0.3)\n",
        "plt.show()\n",
        "\n",
        "print(f\"FUGA máxima en el dataset: ${dataframe['FUGA_NUM'].max():,.0f}\")\n",
        "print(f\"Fuga promedio: {dataframe['FUGA_NUM'].mean():,.0f}\")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 446
        },
        "id": "jjiYpn01WuKF",
        "outputId": "14d2bdcc-66a9-4b3a-c1da-5a0092128755"
      },
      "execution_count": null,
      "outputs": [
        {
