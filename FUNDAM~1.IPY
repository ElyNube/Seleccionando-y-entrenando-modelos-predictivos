    {
      "cell_type": "code",
      "source": [
        "# # Este script funciona porque se corrio antes ** LA REGLA DE LA FUGA\n",
        "#Validacion Tecnica\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# 1. DEFINICIÓN DE LA PIZARRA (Esto es lo que faltaba)\n",
        "# Creamos 1 fila y 2 columnas para comparar el antes y el después\n",
        "fig, axes = plt.subplots(1, 2, figsize=(15, 6))\n",
        "\n",
        "# 2. Gráfico ANTES de escalar\n",
        "# Usamos X_train (datos originales)\n",
        "sns.boxplot(data=X_train, ax=axes[0], palette=\"Set2\")\n",
        "axes[0].set_title('Antes de StandardScaler', fontsize=14)\n",
        "# Rotamos las etiquetas para que se lean bien\n",
        "axes[0].set_xticklabels(['EDAD', 'M_MOROSO', 'MONTO'], fontsize=10, rotation=45)\n",
        "axes[0].set_ylabel('Valores originales', fontsize=12)\n",
        "axes[0].grid(alpha=0.3)\n",
        "\n",
        "# 3. Gráfico DESPUÉS de escalar\n",
        "# Usamos X_train_scaled[:, 1:] para saltarnos la columna de unos (sesgo)\n",
        "# y que las cajas se vean grandes y claras.\n",
        "sns.boxplot(data=X_train_scaled[:, 1:], ax=axes[1], palette=\"Set2\")\n",
        "axes[1].set_title('Después de StandardScaler', fontsize=14)\n",
        "axes[1].set_xticklabels(['EDAD', 'M_MOROSO', 'MONTO'], fontsize=10, rotation=45)\n",
        "axes[1].set_ylabel('Valores estandarizados (Z-scores)', fontsize=12)\n",
        "axes[1].grid(alpha=0.3)\n",
        "\n",
        "# Ajustar espacio para que no se corten las letras de abajo\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
