    {
      "cell_type": "markdown",
      "source": [
        "# Fase 4: Modelado (Modeling)"
      ],
      "metadata": {
        "id": "-1CSKKIx1Kx-"
      }
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Script Actualizado porque se agrego SESGOS en el Analisis"
      ],
      "metadata": {
        "id": "Y5TONArm8MyJ"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Imagen1\n",
        "# Funcion de Costo\n",
        "def compute_mse(X, y, beta):\n",
        "    \"\"\"\n",
        "    Calcula el Error Cuadrático Medio (MSE)\n",
        "    \"\"\"\n",
        "    m = len(y)\n",
        "    predictions = X.dot(beta)\n",
        "    cost = (1 / (2 * m)) * np.sum(np.square(predictions - y))    # Se usa 1/(2m) para simplificar el cálculo del gradiente posteriormente\n",
        "    return cost\n",
        "\n",
        "# Algoritmo de Descenso de Gradiente\n",
        "def gradient_descent(X, y, alpha, num_iters, tol=1e-5):\n",
        "    \"\"\"\n",
        "    Ejecuta el algoritmo de Descenso de Gradiente.\n",
        "    \"\"\"\n",
        "    m = len(y)\n",
        "    beta = np.zeros(X.shape[1])    # Inicializa los coeficientes en cero\n",
        "    cost_history = []\n",
        "\n",
        "# Agregado#1\n",
        "    print(f\"--- Iniciando entrenamiento con alpha={alpha} ---\")\n",
        "\n",
        "    for i in range(num_iters):\n",
        "        predictions = X.dot(beta)\n",
        "        errors = predictions - y\n",
        "        gradient = (1 / m) * X.T.dot(errors)         # Cálculo del gradiente\n",
        "        beta_new = beta - alpha * gradient           # Actualización de los parámetros\n",
        "        current_cost = compute_mse(X, y, beta_new)   # Se guarda el costo histórico\n",
        "        cost_history.append(current_cost)\n",
        "\n",
        "# Agregado#2\n",
        "  # --- BLOQUE DE PRINT AGREGADO ---\n",
        "        # Imprime el progreso cada 100 iteraciones para monitoreo\n",
        "        if i % 100 == 0:\n",
        "            print(f\"Iteración {i}: Costo actual = {current_cost:.6f}\")\n",
        "        # --------------------------------\n",
        "\n",
        "\n",
        "        # Criterio de convergencia: si la norma del cambio en los pesos es menor a la tolerancia\n",
        "        #if np.linalg.norm(beta_new - beta) < tol:\n",
        "        #    print(f\"Convergencia alcanzada en la iteración {i}\")\n",
        "        #    beta = beta_new\n",
        "        #    break\n",
        "\n",
        "# Agregado#3\n",
        "        if np.linalg.norm(beta_new - beta) < tol:\n",
        "            print(f\"¡Convergencia alcanzada en la iteración {i}!\")\n",
        "            print(f\"Costo final: {current_cost:.6f}\")\n",
        "            beta = beta_new\n",
        "            break\n",
        "\n",
        "        beta = beta_new\n",
        "# Agrega #4\n",
        "# --- SUGERENCIA INTEGRADA: Graficación automática del historial de costo ---\n",
        "    plt.figure(figsize=(10, 6))\n",
        "    plt.plot(cost_history, color='blue', linewidth=2)\n",
        "    plt.title(f\"Curva de Aprendizaje (alpha={alpha})\")\n",
        "    plt.xlabel(\"Iteraciones\")\n",
        "    plt.ylabel(\"Costo (MSE)\")\n",
        "    plt.grid(True, alpha=0.3)\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "    return beta, cost_history\n",
        "\n",
        "# print(\"Script cargado correctamente.\")\n",
        "print(\"Script completo cargado. Incluye monitoreo por print y gráfico de convergencia.\")"
      ],
      "metadata": {
        "id": "YwG4u8Zwd9sq",
