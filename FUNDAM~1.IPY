    {
      "cell_type": "code",
      "source": [
        "# 1. Define tu lista de 5 variables (asegúrate de incluir 'FUGA_NUM' para la correlación)\n",
        "mis_variables = ['EDAD', 'MONTO', 'M_MOROSO', 'GENERO_NUM', 'FUGA_NUM']\n",
        "\n",
        "# 2. Filtramos el dataframe antes de calcular la correlación\n",
        "FUGA_corr_5 = dataframe[mis_variables].corr(numeric_only=True)[['FUGA_NUM']].sort_values(by='FUGA_NUM', ascending=False).T\n",
        "\n",
        "# 3. Graficamos\n",
        "plt.figure(figsize=(15, 5))\n",
        "sns.heatmap(FUGA_corr_5, annot=True, cmap='coolwarm', fmt='.2f', linewidths=0.5)\n",
        "\n",
        "plt.xticks(rotation=45, ha='right')\n",
        "plt.subplots_adjust(bottom=0.4)\n",
        "plt.title(\"Correlación: Top 5 Variables seleccionadas\")\n",
        "plt.show()"
      ],
