      "cell_type": "code",
      "source": [
        "# --- FASE 5: EVALUACIÓN  ---\n",
        "# 1. Predicciones\n",
        "predictions = np.dot(X_train_scaled, beta_gd)\n",
        "\n",
        "print(f\"Total de predicciones: {len(predictions)}\")\n",
        "print(\"Primeras 5 predicciones:\", predictions[0:5])\n",
        "\n",
        "# 2. Error final\n",
        "mse_final = compute_mse(X_train_scaled, y_train, beta_gd)\n",
        "print(f\"Error Cuadrático Medio (MSE): {mse_final:.6f}\")\n",
        "\n",
        "# 3. Gráfico\n",
        "plt.figure(figsize=(10, 6))\n",
        "plt.scatter(y_train, predictions, color='blue', alpha=0.5, label='Predicciones')\n",
        "plt.plot([y_train.min(), y_train.max()], [y_train.min(), y_train.max()], 'r--', lw=3, label='Ideal')\n",
        "plt.title('Evaluación: Reales vs Predicciones')\n",
        "plt.xlabel('Valor Real')\n",
        "plt.ylabel('Valor Predicho')\n",
        "plt.legend()\n",
        "plt.grid(True, alpha=0.3)\n",
        "plt.show()"
      ],
